<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/proximanovaregular"
        android:text="@string/no_servers_in_list"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbAddServerToDb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_16"
        android:layout_marginTop="@dimen/padding_16"
        android:background="@drawable/button_selector"
        android:text="@string/add_new_server"
        android:textColor="@color/button_text_selector"
        app:layout_constraintEnd_toEndOf="@id/tvErrorText"
        app:layout_constraintStart_toStartOf="@id/tvErrorText"
        app:layout_constraintTop_toBottomOf="@id/tvErrorText" />

</androidx.constraintlayout.widget.ConstraintLayout>