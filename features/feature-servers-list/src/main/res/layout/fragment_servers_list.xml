<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_16"
    tools:context=".presentation.ServersListFragment">

    <ImageView
        android:id="@+id/ivBackToPrevScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/arrow_back"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.1" />

    <include
        android:id="@+id/iLoadingLayout"
        layout="@layout/loading_layout" />

    <include
        android:id="@+id/iServersListLayout"
        layout="@layout/servers_list_layout" />

    <include
        android:id="@+id/iErrorLayout"
        layout="@layout/servers_list_error_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>